# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then run: ./scripts/start.sh "your query"

# ── LLM Configuration ───────────────────────────────────────────────
# Your LLM API key. Required unless using Ollama (see below).
LLM_API_KEY=sk-YOUR_KEY_HERE

# API base URL. Examples:
#   OpenAI:         https://api.openai.com/v1
#   Aliyun Qwen:    https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   Anthropic:      https://api.anthropic.com/v1
#   DeepSeek:       https://api.deepseek.com/v1
LLM_API_BASE=https://api.openai.com/v1

# Model ID (provider-specific). Examples:
#   OpenAI:       gpt-5.4
#   Qwen (Aliyun): qwen3.8-max
#   DeepSeek:     deepseek-chat
LLM_MODEL_ID=gpt-5.4

# Which entry in config/picoclaw.config.json model_list to use.
#   "default"      → uses LLM_API_KEY / LLM_API_BASE / LLM_MODEL_ID above (cloud provider)
#   "ollama-local" → uses http://127.0.0.1:11434/v1 (Ollama must be running; LLM_MODEL_ID
#                    should match a model you pulled, e.g. qwen3:32b)
PICOCRAW_MODEL_NAME=default

# Disable extended thinking (qwen3.8-max etc.) — speeds up each LLM call by
# skipping the model's internal reasoning trace. Set to "off" for speed,
# or "medium"/"high" if you want deeper reasoning for complex tasks.
LLM_THINKING_LEVEL=off

# ── Ollama (local, free, optional) ──────────────────────────────────
# To use Ollama instead of a cloud API:
#   1. Install Ollama:  https://ollama.com
#   2. Pull a model:    ollama pull qwen3:32b
#   3. Set LLM_MODEL_ID above to match the pulled model name (e.g. qwen3:32b)
#   4. Set PICOCRAW_MODEL_NAME=ollama-local
#   5. LLM_API_KEY can stay empty — Ollama doesn't require it.

# ── Browser MCP (advanced) ──────────────────────────────────────────
# Chrome remote debugging port (must match what launch-chrome.sh uses)
CDP_PORT=9222

# browser-mcp HTTP port (must match what start.sh expects)
MCP_PORT=19002

# Optional: enable Bearer auth for browser-mcp. Set to a non-empty random token
# to require an "Authorization: Bearer <token>" header from MCP clients.
# Recommended if the MCP port is ever exposed to a non-local network.
# MCP_AUTH_TOKEN=your-random-token

# Keep the browser-mcp process alive across runs (default: 1). Set to 0 to force
# a restart on every start.sh invocation.
# MCP_KEEP_ALIVE=1
