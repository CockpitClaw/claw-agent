<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
        WRITE_SECURE_SETTINGS：用于编程方式自动启用 NativeAccessibilityService。
        普通设备（非平台签名）无法获得此权限，需要用户手动在「设置 → 无障碍」开启。
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClawAgent"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <!-- 主入口：WebView 远程控制（承载 CDP + MCP 工具层） -->
        <activity
            android:name=".WebViewRemoteControlActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode|screenLayout|smallestScreenSize|density|fontScale"
            android:theme="@style/Theme.ClawAgent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- McpServerService — 常驻托管 MCP Server（:19003），与 Activity 解耦 -->
        <service
            android:name="com.clawagent.mcp.McpServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- NativeAccessibilityService — 为 MCP 无障碍工具提供原生 UI 控制能力 -->
        <service
            android:name="com.clawagent.accessibility.NativeAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/native_accessibility_service_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/native_accessibility_service_config" />
        </service>

    </application>

</manifest>