{
  "session": {
    "dimensions": [
      "chat"
    ]
  },
  "version": 3,
  "isolation": {},
  "agents": {
    "defaults": {
      "workspace": "~/.picoclaw/workspace",
      "restrict_to_workspace": true,
      "allow_read_outside_workspace": false,
      "provider": "",
      "model_name": "${PICOCRAW_MODEL_NAME}",
      "max_tokens": 65536,
      "max_tool_iterations": 70,
      "summarize_message_threshold": 10,
      "summarize_token_percent": 75,
      "steering_mode": "one-at-a-time",
      "subturn": {
        "max_depth": 0,
        "max_concurrent": 0,
        "default_timeout_minutes": 0,
        "default_token_budget": 0,
        "concurrency_timeout_sec": 0
      },
      "tool_feedback": {
        "enabled": false,
        "max_args_length": 300,
        "separate_messages": false
      },
      "split_on_marker": false,
      "turn_profile": {
        "enabled": false,
        "history": {},
        "system_prompt": {},
        "skills": {},
        "tools": {}
      },
      "max_llm_retries": 2,
      "llm_retry_backoff_secs": 2
    }
  },
  "evolution": {
    "min_task_count": 2,
    "min_success_ratio": 0.7
  },
  "channel_list": {
    "deltachat": {
      "enabled": false,
      "type": "deltachat",
      "reasoning_channel_id": "",
      "group_trigger": {
        "mention_only": true
      },
      "typing": {},
      "placeholder": {
        "enabled": false
      },
      "settings": {
        "display_name": "PicoClaw Bot",
        "email": "@nine.testrun.org"
      }
    },
    "dingtalk": {
      "enabled": false,
      "type": "dingtalk",
      "reasoning_channel_id": "",
      "group_trigger": {},
      "typing": {},
      "placeholder": {
        "enabled": false
      }
    },
    "discord": {
      "enabled": false,
      "type": "discord",
      "reasoning_channel_id": "",
