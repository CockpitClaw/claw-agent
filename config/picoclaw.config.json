    "line": {
      "enabled": false,
      "type": "line",
      "reasoning_channel_id": "",
      "group_trigger": {
        "mention_only": true
      },
      "typing": {},
      "placeholder": {
        "enabled": false
      },
      "settings": {
        "webhook_host": "0.0.0.0",
        "webhook_path": "/webhook/line",
        "webhook_port": 18791
